# Copy to .env. Everything here is optional for local use; set all of it for anything else.

# The key the demo tenant and the web console use.
DEMO_API_KEY=demo-key
# Turns on POST /api/admin/tenants for onboarding customers.
ADMIN_TOKEN=
# Shared by the API and the nginx edge.
HLS_SIGNING_SECRET=devsecret
# Proves callbacks to the API really come from MediaMTX.
MEDIAMTX_AUTH_SECRET=devsecret
# Lets the edge identify itself to MediaMTX.
MEDIAMTX_CDN_SECRET=devsecret
# What the broadcast service reads signals with. Letters and digits only, e.g. openssl rand -hex 32
MEDIAMTX_READ_SECRET=devsecret

# Encrypts the keys customers give for YouTube and Twitch. Make one with: openssl rand -base64 32
# Without it, outputs can't be set up, and everything else works. There is no default, and changing it means
# entering every destination's key again.
# OUTPUT_ENCRYPTION_KEY=
# Lets outputs send to private addresses, which is only for testing against a local server.
# OUTPUTS_ALLOW_PRIVATE_TARGETS=false

# What browsers and encoders connect to, when not running on localhost.
# PUBLIC_EDGE_URL=http://localhost:8080
PUBLIC_RTMP_URL=rtmp://localhost:1935
PUBLIC_SRT_URL=srt://localhost:8890
PUBLIC_WEB_URL=http://localhost:3000
# What an operator's browser connects to for previews: MediaMTX's port 8889, and the host for its UDP port 8189.
# PUBLIC_WEBRTC_URL=http://localhost:8889
# PUBLIC_WEBRTC_HOST=127.0.0.1

# The port the edge listens on, if 8080 is taken. Without PUBLIC_EDGE_URL, the API follows it.
# EDGE_PORT=8080
