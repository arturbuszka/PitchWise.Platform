# Copy to .env. Everything here is optional for local use; set all of it for anything else.

# The key the demo tenant and the web console use.
DEMO_API_KEY=demo-key
# Turns on POST /api/admin/tenants for onboarding customers.
ADMIN_TOKEN=
# Shared by the API and the nginx edge.
HLS_SIGNING_SECRET=devsecret
# Proves callbacks to the API really come from MediaMTX.
MEDIAMTX_AUTH_SECRET=devsecret
# Lets the edge identify itself to MediaMTX.
MEDIAMTX_CDN_SECRET=devsecret

# What browsers and encoders connect to, when not running on localhost.
PUBLIC_EDGE_URL=http://localhost:8080
PUBLIC_RTMP_URL=rtmp://localhost:1935
