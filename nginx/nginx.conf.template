# PitchWise HLS edge — simulates a CDN: validates signed URLs and serves/caches
# HLS segments so the application server (.NET) never touches video bytes.
#
# Only ${HLS_SIGNING_SECRET} and ${MEDIAMTX_CDN_SECRET} are substituted at startup (NGINX_ENVSUBST_FILTER);
# nginx runtime vars like $uri, $arg_md5, $secure_link stay literal.
#
# Signature model:
#   The API signs the DIRECTORY PREFIX "/hls/{id}/" and hands the browser a manifest
#   URL with ?md5=&expires=. The PLAYER, however, fetches segment_*.ts using the
#   RELATIVE names from the manifest — WITHOUT the query string. Native HLS players
#   (Safari/iOS, Android Chrome) never propagate the manifest's query to segments, so
#   a query-only signature makes every segment a 403.
#
#   Fix: when we serve the manifest, sub_filter rewrites each relative "segment_NNN.ts"
#   line to "segment_NNN.ts?md5=&expires=" carrying the SAME signature the manifest was
#   requested with. The player then fetches every segment with the query string already
#   embedded, so it authorizes itself against the same "/hls/{id}/" prefix. Works for
#   hls.js and native players alike, no cookies/credentials needed.
#
# Two server blocks:
#   :80   public edge — validates the signed URL, then proxies to the origin WITH caching.
#   :8081 internal origin (loopback only) — plain static file server off the shared volume.

# Edge cache ("CDN edge"). First viewer warms it (MISS); later viewers hit it (HIT).
proxy_cache_path /var/cache/nginx/hls levels=1:2 keys_zone=hls:10m max_size=1g
                 inactive=10m use_temp_path=off;

upstream mediamtx {
    server mediamtx:8888;
}

# Public edge.
server {
    listen 80;
    server_name _;

    # Live: the signature sits in the path, so relative playlist and segment URLs inherit it and
    # nothing has to be rewritten. The cache key leaves it out, so all viewers share each entry.
    # Playlists change every couple of seconds. A one-second cache with a lock still means that
    # any number of viewers cost the origin about one request per second.
    location ~ "^/live/(?<live_md5>[^/]+)/(?<live_exp>[0-9]+)/(?<live_id>[0-9a-f-]{36})/(?<live_file>[A-Za-z0-9_.-]+\.m3u8)$" {
        secure_link $live_md5,$live_exp;
        secure_link_md5 "$secure_link_expires /live/$live_id/ ${HLS_SIGNING_SECRET}";
        if ($secure_link = "")  { return 403; }
        if ($secure_link = "0") { return 410; }

        proxy_pass http://mediamtx/live/$live_id/$live_file;
        # Tells MediaMTX this is a CDN, so it drops per-viewer sessions and the cache can be shared.
        proxy_set_header Authorization "Bearer ${MEDIAMTX_CDN_SECRET}";
        proxy_cache hls;
        proxy_cache_valid 200 1s;
        proxy_cache_lock on;
        proxy_cache_key "live/$live_id/$live_file";
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header X-Cache-Status $upstream_cache_status always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
    }

    # Segments never change once written, so they can stay cached for as long as they are in use.
    location ~ "^/live/(?<live_md5>[^/]+)/(?<live_exp>[0-9]+)/(?<live_id>[0-9a-f-]{36})/(?<live_file>[A-Za-z0-9_.-]+)$" {
        secure_link $live_md5,$live_exp;
        secure_link_md5 "$secure_link_expires /live/$live_id/ ${HLS_SIGNING_SECRET}";
        if ($secure_link = "")  { return 403; }
        if ($secure_link = "0") { return 410; }

        proxy_pass http://mediamtx/live/$live_id/$live_file;
        # Tells MediaMTX this is a CDN, so it drops per-viewer sessions and the cache can be shared.
        proxy_set_header Authorization "Bearer ${MEDIAMTX_CDN_SECRET}";
        proxy_cache hls;
        proxy_cache_valid 200 5m;
        proxy_cache_lock on;
        proxy_cache_key "live/$live_id/$live_file";
        proxy_ignore_headers Cache-Control Expires Set-Cookie;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        add_header X-Cache-Status $upstream_cache_status always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
    }

    # A finished recording, straight from disk, which also handles the Range requests of seeking.
    # The signature is in the path, as it is for live streams. Only the vod directory is mounted,
    # and this pattern is the only way into it, so nothing else on disk can be reached.
    location ~ "^/vod/(?<vod_md5>[^/]+)/(?<vod_exp>[0-9]+)/(?<vod_file>rec_[0-9a-f]{32}\.mp4)$" {
        secure_link $vod_md5,$vod_exp;
        secure_link_md5 "$secure_link_expires /vod/$vod_file ${HLS_SIGNING_SECRET}";
        if ($secure_link = "")  { return 403; }
        if ($secure_link = "0") { return 410; }

        alias /srv/vod/$vod_file;
        types {
            video/mp4 mp4;
        }
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
    }

    # The manifest carries the signature in the query string (minted by the API).
    # Validate it, then rewrite the segment lines to carry the same signature so the
    # player fetches each segment already signed.
    location ~ ^/hls/(?<hls_id>[0-9]+)/index\.m3u8$ {
        set $hls_dir "/hls/$hls_id/";

        secure_link $arg_md5,$arg_expires;
        secure_link_md5 "$secure_link_expires $hls_dir ${HLS_SIGNING_SECRET}";

        if ($secure_link = "")  { return 403; }   # bad/missing signature
        if ($secure_link = "0") { return 410; }   # expired

        proxy_pass http://127.0.0.1:8081/hls/$hls_id/index.m3u8;
        proxy_cache hls;
        proxy_cache_valid 200 206 10m;
        # Cache key excludes the token, but the rewrite below depends on it — so the
        # cached body is signature-specific. Include md5 in the key to avoid serving a
        # body stamped with someone else's (expiring) signature.
        proxy_cache_key "$hls_id/index.m3u8/$arg_md5";
        add_header X-Cache-Status $upstream_cache_status always;

        # Append the manifest's own signature to every relative segment reference.
        # In an HLS media playlist ".ts" only ever appears as a segment-name suffix,
        # so a plain ".ts" match is safe. sub_filter_once off → every line.
        sub_filter_types application/vnd.apple.mpegurl;
        sub_filter_once off;
        sub_filter ".ts" ".ts?md5=$arg_md5&expires=$arg_expires";

        # hls.js fetches the manifest/segments cross-origin (page on :3000, edge on :8080).
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
    }

    # Segments — now arrive with the query string the manifest rewrite added.
    location ~ ^/hls/(?<hls_id>[0-9]+)/(?<hls_file>segment_[^/]+\.ts)$ {
        set $hls_dir "/hls/$hls_id/";

        secure_link $arg_md5,$arg_expires;
        secure_link_md5 "$secure_link_expires $hls_dir ${HLS_SIGNING_SECRET}";

        if ($secure_link = "")  { return 403; }   # bad/missing signature
        if ($secure_link = "0") { return 410; }   # expired

        proxy_pass http://127.0.0.1:8081/hls/$hls_id/$hls_file;
        proxy_cache hls;
        proxy_cache_valid 200 206 10m;
        proxy_cache_key "$hls_id/$hls_file";
        add_header X-Cache-Status $upstream_cache_status always;

        add_header Access-Control-Allow-Origin "*" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
    }
}

# Internal origin — loopback only, not published. Plain static files off /srv.
server {
    listen 127.0.0.1:8081;
    server_name _;

    location /hls/ {
        root /srv;                       # /srv/hls/{id}/<file>
        types {
            application/vnd.apple.mpegurl m3u8;
            video/mp2t                    ts;
        }
    }
}
