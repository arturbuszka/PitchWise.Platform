<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The football engine: WorldState + rules, pure math. Vision feeds it observations and
         never reads back into it, so the dependency only points this way. -->
    <ProjectReference Include="..\PitchWise.Engine\PitchWise.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenCvSharp for frame decode, letterbox resize, overlay drawing. -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <!-- ByteTrack.NET: multi-object tracker (replaces supervision.ByteTrack). -->
    <PackageReference Include="ByteTrack.NET" Version="1.0.0" />
  </ItemGroup>

  <!-- Native OpenCV and ONNX Runtime are platform-specific. Use the target RID when publishing
       for a platform, otherwise the OS doing the build. -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')))">
    <!-- DirectML runs on any DX12 GPU with no CUDA install and includes the CPU provider as a
         fallback. It lags the CPU build; 1.24.4 is the latest DirectML release. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <!-- DirectML.dll is not copied to the output by itself, and Windows' older system copy fails
         with E_INVALIDARG in AbiCustomRegistry, so it is copied explicitly below. -->
    <PackageReference Include="Microsoft.AI.DirectML" Version="1.15.4" GeneratePathProperty="true" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
  </ItemGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux')))">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.13.0.20260627" />
  </ItemGroup>

  <!-- Copy the correct (NuGet) DirectML.dll next to the output so ORT doesn't fall back to
       the stale system copy. Windows x64 only; harmless no-op on other RIDs. -->
  <ItemGroup Condition="('$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))) and Exists('$(PkgMicrosoft_AI_DirectML)\bin\x64-win\DirectML.dll')">
    <None Include="$(PkgMicrosoft_AI_DirectML)\bin\x64-win\DirectML.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>DirectML.dll</Link>
    </None>
  </ItemGroup>

</Project>
